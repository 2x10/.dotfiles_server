#!/bin/zsh

#
# ~/.zfunc
#

# - - - functions - - -
format_git_branch() {
    local BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n ${BRANCH} ]] ; then
	    if [[ "$TERM" == "linux" ]]; then
	    	echo "${col1}[${col2}${BRANCH}${col1}]"

	    else
	    	echo "${col1}[${col2}${BRANCH}${col1}]"
	    fi
    fi
}

soft_copy() {
    if [ -f "$1" ]; then
        cp "$1" "$2"
    else
        echo -e "$1" exists. . . skipping
    fi
}

get_ip() {
    ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1
}

toggle_tmux() {
    if [[ -n $TMUX ]]; then
        tmux detach
    else
        BUFFER='tmux new-session -A -s session_00'
        zle accept-line
    fi
}

prefix() {
    echo -n '\n ? '

    local key
    read -k 1 key

    case "$key" in
        0 || a )
            BUFFER='tmux new-session -A -s session_00'
            ;;
        #1)
        #    BUFFER='tmux new-session -A -s session_01'
        #    ;;
        #2)
        #    BUFFER='tmux new-session -A -s session_02'
        #    ;;
        #3)
        #    BUFFER='tmux new-session -A -s session_03'
        #    ;;
        #4)
        #    BUFFER='tmux new-session -A -s session_04'
        #    ;;
        *)
            echo -n "no such bind"
            ;;
    esac
    zle accept-line
}

get_time() {
	echo "$(date '+%H:%M')"
}

get_date() {
 	echo "$(date '+%d.%m.%Y')"
}

log() {
	less "/var/log/$1"
}

_log() {
	_files -W /var/log
}

log_err() {
	sudo dmesg | grep -E 'volt|throt|power|err'
}

temp() {
    for z in /sys/class/thermal/thermal_zone*; do
        printf '%s: %s %s\n' \
            "$z" \
            "$(cat "$z/type")" \
            "$(awk '{printf "%.1f°C", $1/1000}' "$z/temp")"
    done
}



compdef _log log
zle -N toggle_tmux
zle -N prefix
