#/usr/bin/zsh

#
# ~/.zconfig
#

autoload -U colors && colors

source ~/.zfunc

# usr
nocol='false'
swag='true'

symbol=''
at=''
col1=''
col2=''
PS1=''
n=$'\n'
s=$' '

if [[  "$swag" == 'true' ]]; then
    symbol='󰏩'
    at='@'
else
    symbol='$'
    at='@'
fi


PS1="%f%n@%m %~ $ "
if [[ "$nocol" == 'false' ]]; then
    if [[ "$TERM" == "linux" ]]; then
        if [[ "$(id -u)" == "0" ]]; then
            col1='%F{8}'
            col2='%F{1}'
        else
            col1='%F{8}'
            col2='%F{5}'
        fi
   
        ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=4,bold'
        precmd() {
            PS1="${col1}[%n${col2}@%m${col1}] [${col2}%~${col1}] %f$ "
        }
    else
        if [[ "$(id -u)" == "0" ]]; then
            col1='%F{238}'
            col2='%F{124}'
        else
            col1='%F{237}'
            col2='%F{141}'
        fi
    
        ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
        
        precmd() {
            PS1="${col1}╔[%n${col2}${at}%m${col1}] [${col2}%~${col1}] $(format_git_branch)${n}╙ %f${symbol} "
        }
    fi
else
    col1='%F{8}'
    col2='%F{8}'
fi

